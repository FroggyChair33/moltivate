{
  "name": "moltivate",
  "private": true,
  "version": "0.1.0",
  "description": "Moltivate landing page and interactive frontend preview",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "check:build": "node scripts/verify-build.mjs",
