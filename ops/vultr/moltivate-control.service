[Unit]
Description=Moltivate signed worker control API
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/moltivate-live
EnvironmentFile=%h/.config/moltivate-live/control.env
ExecStart=%h/moltivate-live/.transport-venv/bin/python services/vision-worker/control_api.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
MemoryMax=256M

[Install]
WantedBy=default.target
