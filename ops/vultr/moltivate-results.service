[Unit]
Description=Deliver queued Moltivate workout results

[Service]
Type=oneshot
WorkingDirectory=%h/moltivate-live
EnvironmentFile=%h/.config/moltivate-live/results.env
ExecStart=%h/moltivate-live/.transport-venv/bin/python services/vision-worker/result_sender.py drain
NoNewPrivileges=true
UMask=0077
