# Solana (devnet only -- see AGENTS.md "Financial correctness")
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Supabase (off-chain index: profiles/linked_wallets/wallet_link_nonces/workout_sessions/closed_challenges)
NEXT_PUBLIC_SUPABASE_URL=
# Public by design (ships in the browser). Must be the anon/publishable key, never the service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Backend oracle (app/api/oracle/settle) -- devnet only. Public key is the
# default `oracle` on new challenges; secret key signs the on-chain settle()
# call server-side and must never reach the client or be committed.
NEXT_PUBLIC_ORACLE_PUBKEY=
# JSON array of 64 bytes, e.g. [1,2,3,...]. Server-only.
ORACLE_SECRET_KEY=
