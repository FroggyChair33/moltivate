# Solana (devnet only -- see AGENTS.md "Financial correctness")
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Supabase (off-chain index: users/challenges/teams/workout_sessions/settlements)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Backend oracle (app/api/oracle/settle) -- devnet only. Public key is the
# default `oracle` on new challenges; secret key signs the on-chain settle()
# call server-side and must never reach the client or be committed.
NEXT_PUBLIC_ORACLE_PUBKEY=
# JSON array of 64 bytes, e.g. [1,2,3,...]. Server-only.
ORACLE_SECRET_KEY=

# Shared secret the Chert/MediaPipe verification service (hosted separately,
# e.g. a hackathon-sponsor VM) presents as `Authorization: Bearer <this>` when
# POSTing to /api/workout-sessions, so it alone can assert a real trustLevel/
# livenessResult. Every other caller is forced to trust_level 'unverified'
# regardless of auth. Server-only - never commit a real value. Generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
WORKOUT_INGEST_SECRET=
